{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/produtos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/produtos/:slug",
      "destination": "/pages/produto.html?slug=:slug",
      "permanent": true
    },
    {
      "source": "/unidades",
      "destination": "/pages/unidades.html",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/pages/sobre.html",
      "permanent": true
    },
    {
      "source": "/carrinho",
      "destination": "/pages/carrinho.html",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/unidades.php",
      "destination": "/pages/unidades.html",
      "permanent": true
    },
    {
      "source": "/sobre.php",
      "destination": "/pages/sobre.html",
      "permanent": true
    },
    {
      "source": "/carrinho.php",
      "destination": "/pages/carrinho.html",
      "permanent": true
    },
    {
      "source": "/produto.php",
      "destination": "/pages/produto.html",
      "permanent": true
    },
    {
      "source": "/catalogos/:arquivo/download",
      "destination": "/catalogos/:arquivo.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/dados/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
